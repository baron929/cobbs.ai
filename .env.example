# Copy to .env locally and replace every placeholder before starting Compose.
# Do not commit the copied .env file.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
COBBSAI_ISSUER=https://your-casdoor.example.com
COBBSAI_CLIENT_ID=replace-with-casdoor-client-id
COBBSAI_CLIENT_SECRET=replace-with-casdoor-client-secret
COBBSAI_ORGANIZATION=replace-with-casdoor-organization
COBBSAI_APPLICATION=replace-with-casdoor-application
